{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Fenêtre principale : uniquement les commandes applicatives nécessaires, aucune permission de plugin.",
  "windows": ["main"],
  "permissions": [
    "allow-app-info",
    "allow-ssh-connect",
    "allow-ssh-write",
    "allow-ssh-resize",
    "allow-ssh-ack",
    "allow-ssh-host-key-decision",
    "allow-ssh-close",
    "allow-ssh-pick-key-file",
    "allow-open-external-url",
    "allow-ssh-connect-host",
    "allow-vault-status",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-change-password",
    "allow-vault-touch",
    "allow-vault-watch",
    "allow-vault-set-auto-lock",
    "allow-vault-snapshot",
    "allow-host-save",
    "allow-host-delete",
    "allow-group-save",
    "allow-group-delete",
    "allow-snippet-save",
    "allow-snippet-delete",
    "allow-identity-save",
    "allow-identity-delete",
    "allow-key-import",
    "allow-key-rename",
    "allow-key-delete",
    "allow-known-host-list",
    "allow-known-host-delete",
    "allow-settings-get",
    "allow-settings-set",
    "allow-ssh-auth-answer",
    "allow-key-generate",
    "allow-key-export-public",
    "allow-key-deploy",
    "allow-sftp-open",
    "allow-sftp-close",
    "allow-sftp-home",
    "allow-sftp-list",
    "allow-sftp-mkdir",
    "allow-sftp-rename",
    "allow-sftp-remove",
    "allow-sftp-chmod",
    "allow-sftp-download",
    "allow-sftp-upload",
    "allow-sftp-transfer-cancel",
    "allow-sftp-conflict-decision",
    "allow-sftp-edit",
    "allow-sftp-edit-close",
    "allow-sftp-edit-force",
    "allow-local-pick-root",
    "allow-local-list",
    "allow-term-profiles",
    "allow-term-open",
    "allow-term-write",
    "allow-term-resize",
    "allow-term-ack",
    "allow-term-close",
    "allow-rdp-launch"
  ]
}
